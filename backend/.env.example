# ============================================================
# DevApp Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# ---- Database ----
# For production use PostgreSQL. SQLite is for local dev only.
# Production format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://devapp:CHANGE_ME@localhost:5432/devapp
# Dev/local SQLite (fallback only):
# DATABASE_URL=sqlite:///./devapp_v2.db

# ---- JWT Auth (Local auth mode) ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ---- Supabase ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ---- Auth Mode ----
# 'supabase' for production, 'local' for dev-only JWT testing
AUTH_MODE=supabase

# ---- Environment ----
# Set to 'production' in production - enables strict JWT checks
ENVIRONMENT=production

# ---- Sentry (optional) ----
SENTRY_DSN=

# ---- CORS ----
# Comma-separated list of allowed origins. DO NOT use ["*"] in production.
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=["https://yourdomain.com"]
